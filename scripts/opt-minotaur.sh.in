#!/bin/bash

set -e

#if [[ "$OSTYPE" == "darwin"* ]]; then
#  # Mac
#  MINOTAUR_SHAREDLIB=minotaur.dylib
#else
#  # Linux
#  MINOTAUR_SHAREDLIB=@CACHE_EXPRS_PASS.so
#fi

#TV_REPORT_DIR=-plugin-arg=minotaur,-minotaur-report-dir=@CMAKE_BINARY_DIR@/logs
TV_SMT_TO=-plugin-arg=minotaur,-minotaur-query-to=20000
DEBUG=true
# ABM rewrites are cheap enough to win almost any cut, so the general tests
# run without them; abm-check sets MINOTAUR_ABM=1
ABM_MODE=off
[[ "${MINOTAUR_ABM:-0}" == 1 ]] && ABM_MODE=both


SKIP=0

for arg do
  shift
  [[ $arg = -passes* ]] && continue
  [[ $arg = -O* ]] && continue
  set -- "$@" "$arg"
done


if [[ $SKIP == 0 ]]; then
@LLVM_BINARY_DIR@/bin/opt -load-pass-plugin=@ONLINE_PASS@ \
  $@ \
  -passes="minotaur" \
  -plugin-arg=minotaur,-minotaur-enable-caching=false \
  -plugin-arg=minotaur,-minotaur-ignore-machine-cost=true \
  -plugin-arg=minotaur,-minotaur-debug-codegen=false \
  -plugin-arg=minotaur,-minotaur-debug-enumerator=$DEBUG \
  -plugin-arg=minotaur,-minotaur-debug-tv=true \
  -plugin-arg=minotaur,-minotaur-abm-mode=$ABM_MODE \
  #-plugin-arg=minotaur,-minotaur-no-infer=true \
  $TV_REPORT_DIR
else
  @LLVM_BINARY_DIR@/bin/opt
fi
